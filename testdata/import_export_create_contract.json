        "source_config": {"common_file_task_config": {"uris": ["s3://bucket/资料.pdf"], "load_mode_config": {"load_interval_type": 4, "interval": 0}, "file_filter_config": {"file_types": [7]}}}
      },
      "response": {"task_id": "import-1"}
    },
    {
      "name": "explicit name without volume",
      "request": {
        "source_connector_id": "connector-1",
        "config_type": 1,
        "name": "资料导入",
        "source_config": {"common_file_task_config": {"uris": ["s3://bucket/资料.pdf"], "load_mode_config": {"load_interval_type": 4, "interval": 0}, "file_filter_config": {"file_types": [7]}}}
      },
      "response": {"task_id": "import-2"}
    },
    {
      "name": "explicit volume with server supplied name",
      "request": {
        "source_connector_id": "connector-1",
        "config_type": 1,
        "volume_id": "17",
        "source_config": {"common_file_task_config": {"uris": ["s3://bucket/资料.pdf"], "load_mode_config": {"load_interval_type": 4, "interval": 0}, "file_filter_config": {"file_types": [7]}}}
      },
      "response": {"task_id": "import-3"}
    },
    {
      "name": "explicit name volume and false unzip option",
      "request": {
        "source_connector_id": "connector-1",
        "config_type": 1,
        "name": "资料导入",
        "volume_id": "17",
        "source_config": {"common_file_task_config": {"uris": ["s3://bucket/资料.pdf"], "load_mode_config": {"load_interval_type": 4, "interval": 0}, "file_filter_config": {"file_types": [7]}, "unzip_keep_structure": false, "file_storage_mode": "copy"}}
      },
      "response": {"task_id": "import-4"}
    }
  ],
  "explicit_task_import": {
    "name": "caller supplied task ID",
    "request": {
      "task_id": "chosen-import-5",
      "source_connector_id": "connector-1",
      "config_type": 1,
      "source_config": {"common_file_task_config": {"uris": ["s3://bucket/资料.pdf"], "load_mode_config": {"load_interval_type": 4, "interval": 0}, "file_filter_config": {"file_types": [7]}}}
    },
    "response": {"task_id": "chosen-import-5"}
