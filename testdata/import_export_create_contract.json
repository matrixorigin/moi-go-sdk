  "exports": [
    {
      "name": "typed export with an explicit false option",
      "request": {
        "task_name": "导出资料",
        "connector_id": "connector-1",
        "connector_name": "S3",
        "type": 2,
        "config": {"merge_title_to_text": false, "s3_config": {"path": "/exports"}},
        "files": [{"file_id": "file-1", "full_path": ["资料库", "资料.pdf"], "is_raw": true}]
      },
      "response": {"id": "export-1", "name": "导出资料", "connector_name": "S3", "type": 2, "status": 0, "export_source": [["资料库", "资料.pdf"]], "create_time": null, "end_time": null}
    },
    {
      "name": "export creator label is preserved",
      "request": {
        "task_name": "导出财务资料",
        "creator": "财务组",
        "connector_id": "connector-1",
        "connector_name": "S3",
        "type": 2,
        "config": {"s3_config": {"path": "/exports"}},
        "files": [{"file_id": "file-1", "full_path": ["资料库", "资料.pdf"], "is_raw": false}]
      },
      "response": {"id": "export-creator-2", "name": "导出财务资料", "connector_name": "S3", "type": 2, "status": 0, "export_source": [["资料库", "资料.pdf"]], "create_time": null, "end_time": null}
    },
    {
      "name": "export requires a task name",
      "request": {
        "task_name": "",
        "connector_id": "connector-1",
        "connector_name": "S3",
        "type": 2,
        "config": {"s3_config": {"path": "/exports"}},
        "files": [{"file_id": "file-1", "full_path": ["资料库", "资料.pdf"], "is_raw": true}]
      },
      "local_error": "ErrTaskNameRequired"
    }
  ],
  "owner_denial": {"status": 403, "body": {"code": "ErrForbidden", "msg": "当前角色不能操作此资源。", "details": {"action": "create"}}}
